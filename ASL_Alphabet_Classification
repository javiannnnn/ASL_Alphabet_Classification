      "source": [
        "base.trainable = True\n",
        "for layer in base.layers[:-30]:\n",
        "    layer.trainable = False\n",
        "\n",
        "kept_frozen = 0\n",
        "for layer in base.layers[-30:]:\n",
        "    if isinstance(layer, keras.layers.BatchNormalization):\n",
